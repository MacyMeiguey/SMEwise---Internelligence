# Copy to server/.env. See AWS_RESTART.md before creating AWS resources.
PORT=3001
NODE_ENV=development
AWS_REGION=us-east-1

# Preferred: configure a local AWS CLI profile, then set AWS_PROFILE here.
# Leave credential variables below empty when using a profile or deployed role.
AWS_PROFILE=smewise-showcase
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required alongside the two keys when using temporary lab / STS credentials.
AWS_SESSION_TOKEN=

# Showcase sandbox blocks Sonnet/Opus. Verify this Haiku profile is allowed.
# Cross-region destinations must also be permitted by the sandbox policy.
BEDROCK_CONVERSE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# All business features now use Converse; Classic agent IDs are not required.

# Comma-separated frontend origins in production; local Vite origins work in dev.
CORS_ORIGIN=
