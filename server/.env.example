# ─── Server runtime ───────────────────────────────────────────────────────────
PORT=3001
# Set to "production" when running in AWS
NODE_ENV=development

# ─── AWS (Bedrock) ────────────────────────────────────────────────────────────
# Region where your Bedrock models / agents / AgentCore runtimes live.
AWS_REGION=ap-southeast-1

# ─── Bedrock AgentCore (marketing harness) ────────────────────────────────────
# The /marketing route invokes a Bedrock AgentCore harness via the InvokeHarness
# API. Use the HARNESS ARN here (not the underlying runtime ARN). Override to
# swap harnesses without a code change. Leave unset to use the built-in default.
MARKETING_HARNESS_ARN=arn:aws:bedrock-agentcore:ap-southeast-1:781897846709:harness/marketingPlan-iS7SeEFIOL
# Optional endpoint/version qualifier (defaults to DEFAULT). Leave empty if unused.
MARKETING_AGENT_QUALIFIER=
# Max tokens the harness may generate per iteration. Raise this if the marketing
# plan JSON is being truncated. Default: 8192.
MARKETING_MAX_TOKENS=8192

# ─── Bedrock AgentCore (marketing-guidelines harness) ─────────────────────────
# The /marketing-guidelines route also invokes a Bedrock AgentCore harness via
# the InvokeHarness API. Use the HARNESS ARN here (not the runtime ARN).
GUIDELINES_HARNESS_ARN=arn:aws:bedrock-agentcore:ap-southeast-1:781897846709:harness/marketingGuidelines-REPLACE_ME
# Optional endpoint/version qualifier (defaults to DEFAULT). Leave empty if unused.
GUIDELINES_AGENT_QUALIFIER=
# Max tokens the guidelines harness may generate per iteration. Default: 8192.
GUIDELINES_MAX_TOKENS=8192

# ─── Bedrock AgentCore (marketing-forecast harness) ───────────────────────────
# The /marketing-forecast route also invokes a Bedrock AgentCore harness via
# the InvokeHarness API. Use the HARNESS ARN here (not the runtime ARN).
FORECAST_HARNESS_ARN=arn:aws:bedrock-agentcore:ap-southeast-1:781897846709:harness/marketingForecast-REPLACE_ME
# Optional endpoint/version qualifier (defaults to DEFAULT). Leave empty if unused.
FORECAST_AGENT_QUALIFIER=
# Max tokens the forecast harness may generate per iteration. Default: 8192.
FORECAST_MAX_TOKENS=8192

# ─── Bedrock AgentCore (profile-verification harness) ─────────────────────────
# The /profile-verification route invokes a Bedrock AgentCore harness via the
# InvokeHarness API. Use the HARNESS ARN here (not the runtime ARN).
PROFILE_HARNESS_ARN=arn:aws:bedrock-agentcore:ap-southeast-1:781897846709:harness/profileVerification-REPLACE_ME
# Optional endpoint/version qualifier (defaults to DEFAULT). Leave empty if unused.
PROFILE_AGENT_QUALIFIER=
# Max tokens the profile-verification harness may generate (output is short). Default: 1024.
PROFILE_MAX_TOKENS=1024

# In LOCAL DEV, paste static credentials here.
# In PRODUCTION (App Runner / ECS / EC2) LEAVE THESE UNSET — the SDK will use
# the IAM role attached to the compute resource instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production. Example:
#   CORS_ORIGIN=https://d123abc.cloudfront.net,https://app.smewise.example.com
# Leave empty in dev — the server allows http://localhost:5173 by default.
CORS_ORIGIN=
