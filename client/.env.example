# Leave empty (or unset) to use relative /api URLs — works for both
# Vite dev (proxied to localhost:3001) and production behind a single
# CloudFront distribution that routes /api/* to the backend.
#
# Set this only if the backend is on a different origin, e.g.:
# VITE_API_BASE_URL=https://api.smewise.example.com
VITE_API_BASE_URL=
