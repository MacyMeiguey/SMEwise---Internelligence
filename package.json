{
  "name": "smewise",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "test": "npm run test --workspace=client && npm run test --workspace=server",
    "generate:product-tour": "node scripts/generate-product-tour.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "concurrently": "^8.2.2",
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1045.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1046.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1045.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.39.0"
  }
}
